<!DOCTYPE html>
<html lang="<%= lang === 'ar' ? 'ar' : 'en' %>" dir="<%= dir %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= t('invoices.report.title') %></title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: <%= dir === 'rtl' ? '"Cairo", "Traditional Arabic", Arial' : '"Segoe UI", Arial' %>, sans-serif;
    background: #f0f2f5;
    padding: 24px;
    color: #222;
  }
  .page {
    max-width: 900px;
    margin: auto;
    background: #fff;
    padding: 30px 28px;
    border-radius: 8px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12);
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 3px double #333;
    padding-bottom: 12px;
    margin-bottom: 8px;
  }
  .center-name { flex: 1; text-align: center; }
  .center-name h2 { font-size: 20px; font-weight: 800; }
  .center-name .english-name { font-size: 11px; letter-spacing: 0.3px; color: #444; margin-top: 4px; line-height: 1.5; }
  .logo .logo-circle {
    width: 64px; height: 64px; border-radius: 50%;
    border: 2px solid #333;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; letter-spacing: 1px; font-size: 15px;
  }
  .organization strong { font-size: 15px; white-space: nowrap; }
  .meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #777;
    margin-bottom: 12px;
    flex-wrap: wrap;
    gap: 8px;
  }
  table.main-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 18px;
  }
  table.main-table th, table.main-table td {
    border: 1px solid #333;
    padding: 8px 10px;
    font-size: 13px;
    text-align: center;
  }
  table.main-table th { background: #f1f1f1; font-weight: 700; }
  .employee-cell { font-weight: 700; vertical-align: middle; }
  .total-cell { font-weight: 800; vertical-align: middle; }
  .amount-total { font-weight: 700; }
  .summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .summary-box {
    flex: 1;
    min-width: 160px;
    max-width: 240px;
    border: 1.5px solid #333;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: center;
  }
  .summary-title { font-size: 13px; font-weight: 700; margin-bottom: 4px; }
  .summary-value { font-size: 18px; font-weight: 800; }
  .invoice-total {
    flex: 1;
    text-align: center;
    font-size: 20px;
    font-weight: 800;
    border: 2px solid #333;
    border-radius: 8px;
    padding: 14px 16px;
    background: #fafafa;
  }
  .empty {
    text-align: center;
    color: #888;
    padding: 30px 0;
  }
  .footer {
    text-align: center;
    font-size: 12px;
    color: #555;
    padding-top: 10px;
    border-top: 1px solid #ddd;
  }
  .print-btn {
    display: block;
    margin: 20px auto 0;
    padding: 10px 32px;
    background: #1a5276;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 15px;
    cursor: pointer;
  }
  .print-btn:hover { background: #154360; }
  @media print {
    body { background: #fff; padding: 0; }
    .page { box-shadow: none; margin: 0; padding: 16px 12px; max-width: 100%; border-radius: 0; }
    .print-btn { display: none; }
    table.main-table th { background: #f1f1f1; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
  @media (max-width: 600px) {
    body { padding: 12px; }
    .page { padding: 18px 14px; }
    .logo .logo-circle { width: 48px; height: 48px; font-size: 12px; }
    .center-name h2 { font-size: 15px; }
    table.main-table th, table.main-table td { padding: 6px; font-size: 11px; }
  }
</style>
</head>
<body>
<div class="page">

  <div class="header">
    <div class="center-name">
      <h2><%= t('invoices.report.centerName') %></h2>
      <div class="english-name"><%= t('invoices.report.centerNameEn') %></div>
    </div>
    <div class="logo">
      <div class="logo-circle">SAMA</div>
    </div>
    <div class="organization">
      <strong><%= t('invoices.report.management') %></strong>
    </div>
  </div>

  <div class="meta">
    <% if (month) { %><span><%= month %></span><% } %>
    <span><%= t('invoices.report.generated') %>: <%= generatedDate %></span>
  </div>

  <% if (rows.length > 0) { %>
  <table class="main-table">
    <thead>
      <tr>
        <th><%= t('invoices.report.num') %></th>
        <th><%= t('invoices.report.date') %></th>
        <th><%= t('invoices.report.day') %></th>
        <th><%= t('invoices.report.type') %></th>
        <th><%= t('invoices.report.amount') %></th>
        <th><%= t('invoices.report.signature') %></th>
        <th><%= t('invoices.report.notes') %></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(r, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= r.dateFormatted %></td>
        <td><%= r.day %></td>
        <td><%= t(r.type === 'water' ? 'invoices.type.water' : 'invoices.type.electricity') %></td>
        <td><%= r.amount.toLocaleString('en-US') %></td>
        <td></td>
        <td><%= r.notes || '' %></td>
      </tr>
      <% }); %>
      <tr>
        <td colspan="4"><%= t('invoices.report.total') %></td>
        <td class="amount-total"><%= total.toLocaleString('en-US') %></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="summary">
    <div class="summary-box">
      <div class="summary-title"><%= t('invoices.report.total') %></div>
      <div class="summary-value"><%= total.toLocaleString('en-US') %></div>
    </div>
    <div class="summary-box">
      <div class="summary-title"><%= t('invoices.report.totalAdvances') %></div>
      <div class="summary-value"><%= total.toLocaleString('en-US') %></div>
    </div>
    <div class="invoice-total">
      <%= t('invoices.report.grandTotal') %>: <%= total.toLocaleString('en-US') %>
    </div>
  </div>
  <% } else { %>
  <p class="empty"><%= t('invoices.report.noInvoices') %></p>
  <% } %>

  <div class="footer">
    <%= t('invoices.report.management') %>
  </div>

  <button class="print-btn" onclick="window.print()"><%= t('invoices.report.print') %></button>
</div>
</body>
</html>
